{
  "manifest_version": 3,
  "name": "Lecture Assistant",
  "description": "Record an online lecture from a browser tab and turn it into notes and a quiz.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Lecture Assistant", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["tabCapture", "offscreen", "storage", "sidePanel", "activeTab", "tabs", "alarms"],
  "host_permissions": ["https://localhost:8443/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
}
